{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "600000",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skills-reminder.js",
            "timeout": 5,
            "statusMessage": "Skills reminder..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-compact-block.js",
            "timeout": 5,
            "statusMessage": "Post-compaction skill-reload gate..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-structure-guard.js",
            "timeout": 5,
            "statusMessage": "SKILL.md structure guard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-skill-load.js",
            "timeout": 5,
            "statusMessage": "Tracking skill load..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/token-tracker.js",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-compact-brief.js",
            "timeout": 10,
            "statusMessage": "Extracting session brief before compaction..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-compact-reload.js",
            "timeout": 5,
            "statusMessage": "Reloading skills after compaction..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/token-tracker.js",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
