            "quests_8h": true,
            "quest_rewards": true,
            "guild": true,
            "free_store_gems": false,
            "gem_orbit": {
              "enabled": true
            }
          }
        },
        "uw_policies": {
          "farm_cl_choreo": {
            "baseline": {
              "black_hole": true,
              "chronofield": true,
              "death_wave": true,
              "golden_tower": true,
              "poison_swamp": true,
              "spotlight": true
            },
            "chain_lightning": {
              "always_on_above": [
                4080,
                4120
              ],
              "mode": "fleet_marks",
              "off_after_waves": [
                53,
                72
              ],
              "pre_mark_waves": [
                5,
                25
              ]
            },
            "label": "Chain Lightning Farming Choreography"
          }
        },
        "rescue_policies": {
          "high_tier_wall": {
            "label": "High Tier Wall",
            "arm": {
              "on": "second_wind",
              "immunity_sec": null,
              "watch_sec": 30
            },
            "end_sprint_after_sw": false,
            "rules": [
              {
                "when": {
                  "bar": "wall",
                  "below": 0.02,
                  "falling_samples": 2,
                  "deadband": 0.01
                },
                "do": {
                  "burst": {
                    "cancel_sprint": true,
                    "fire": "demon_mode",
                    "retaps": 3
                  }
                }
              },
              {
                "when": {
                  "wall_collapse": {
                    "from_above": 0.3
                  }
                },
                "do": {
                  "burst": {
                    "cancel_sprint": true,
                    "fire": "demon_mode",
                    "retaps": 3
                  }
                }
              },
              {
                "when": {
                  "fleet_mark": {
                    "after_waves": 3,
                    "window_waves": 60
                  }
                },
                "do": {
                  "fire": {
                    "button": "nuke",
                    "throttle_sec": 5
                  }
                }
              }
            ]
          }
        },
        "shopping_lists": {
          "default_sweep": {
            "label": "Default Sweep",
            "enabled": true,
            "directives": [
              {
                "enabled": true,
                "tab": "utility",
                "stats": [
                  "enemy_attack_level_skip",
                  "enemy_health_level_skip"
                ],
                "mode": "repeat"
              },
              {
                "enabled": true,
                "tab": "defense",
                "stats": [
                  "death_defy",
                  "land_mine_radius"
                ],
                "mode": "once"
              },
              {
                "enabled": true,
                "tab": "defense",
                "stats": [
                  "health",
                  "health_regen"
                ],
                "mode": "best_cost"
              },
              {
                "enabled": true,
                "tab": "attack",
                "stats": [
                  "critical_factor",
                  "damage_per_meter",
                  "bounce_shot_range",
                  "super_crit_chance",
                  "super_crit_mult"
                ],
                "mode": "once"
              },
              {
                "enabled": true,
                "tab": "attack",
                "stats": [
                  "damage"
                ],
                "mode": "clicks",
                "clicks": 3
              }
            ]
          }
        }
      },
      "optional_policies": {
        "uw": "farm_cl_choreo",
        "rescue": "high_tier_wall"
      },
