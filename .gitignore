# --- machine / account state (never commit) ---------------------------
backend/config.yaml
backend/config.yaml.bak-*
backend/catalogue_local.yaml
backend/accounts/
backend/profiles/*.yaml
!backend/profiles/default.yaml
backend/profiles/*.bak-*
backend/profiles/*.draft.yaml
backend/logs/
# All game-derived images are generated locally; none ship.
backend/templates/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.ico
backend/runs/
backend/captures/
backend/recordings/
backend/_scan_backup_*/
backend/.last_scan_backup
docs/HANDOVER_SCANNING.md
# Personal agent state and session handoffs are not public project docs.
.omo/
docs/HANDOFF-2026-10-12.txt

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
backend/tools/platform-tools/
backend/tools/scrcpy/
backend/tools/adb-install-*/
.local-backups/
dist/
build/
*.egg-info/
venv/

# --- dashboard app (frontend/app, ADR-001) ------------------------------
# The build is produced by CI, the release scripts and `npm run build`; npm
# and Playwright state never ship.
frontend/webui/app/
frontend/app/node_modules/
frontend/app/test-results/
frontend/app/playwright-report/
frontend/app/coverage/
# TypeScript incremental-build cache: machine state, never source
frontend/app/*.tsbuildinfo

# --- editors / os ------------------------------------------------------
.vscode/
.idea/
Thumbs.db
.DS_Store

# Installed game packages and decoded asset binaries stay local.
*.apk
*.aab
*.obb
*.bundle
*.assets
*.resource
*.resS

# Further image and recording types (common image types are listed near the top).
# Captures, screenshots and evidence are machine or account state (CLAUDE.md rule 8);
# a shipped file would need an explicit "!path" exception.
*.tif
*.tiff
*.webm
*.mp4
